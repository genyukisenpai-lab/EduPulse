rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every signed-in learner with a verified email can read and edit their own preferences.
    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.firebase.sign_in_provider != 'anonymous'
                         && request.auth.token.email_verified == true;
    }

    // Thư viện cá nhân "Tài liệu của tôi" — bản sao online, chỉ chủ sở hữu đọc được.
    match /users/{userId}/files/{fileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.chunkCount is int
                    && request.resource.data.chunkCount >= 1
                    && request.resource.data.chunkCount <= 32;
      allow update, delete: if false;

      match /chunks/{chunkId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.token.email_verified == true
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 1000000
                      && request.resource.data.index is int
                      && request.resource.data.index >= 0
                      && request.resource.data.index < 32;
        allow update, delete: if false;
      }
    }

    // Shared community chat: Allow reading for all, but require verified accounts to send messages.
    match /rooms/general/messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    && (!('authorName' in request.resource.data)
                        || (request.resource.data.authorName is string
                            && request.resource.data.authorName.size() <= 32))
                    && (request.resource.data.text.size() > 0
                        || request.resource.data.attachment is map);
      allow update, delete: if false;
    }

    match /rooms/general/files/{fileId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.chunkCount is int
                    && request.resource.data.chunkCount >= 1
                    && request.resource.data.chunkCount <= 32;
      allow update, delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.token.email_verified == true
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 1000000
                      && request.resource.data.index is int
                      && request.resource.data.index >= 0
                      && request.resource.data.index < 32;
        allow update, delete: if false;
      }
    }

    // Calls: 1-1 voice/video (WebRTC signaling qua Firestore — miễn phí)
    match /calls/{callId} {
      function isParticipant(uid) {
        return request.auth != null
          && request.auth.uid == uid;
      }
      allow read: if isParticipant(resource.data.callerUid) || isParticipant(resource.data.calleeUid);
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.callerUid != request.resource.data.calleeUid
                    && request.resource.data.status == 'ringing'
                    && request.resource.data.type in ['voice', 'video']
                    && request.resource.data.callerName is string
                    && request.resource.data.calleeName is string;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid)
                    && request.resource.data.status in ['ringing', 'active', 'ended', 'declined', 'missed', 'busy'];
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);

      match /signals/{signalId} {
        allow read: if request.auth != null
                    && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
        allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.kind in ['sdp', 'ice']
                    && (request.resource.data.from == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid
                        || request.resource.data.from == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid)
                    && request.resource.data.to in [get(/databases/$(database)/documents/calls/$(callId)).data.callerUid, get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid];
        allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
        allow update: if false;
      }
    }

    // Phòng ôn thi trực tiếp: presence + signaling mesh
    match /rooms/study/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.auth.uid == uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 32
                    && request.resource.data.kind in ['voice', 'video'];
      allow delete: if request.auth != null
                    && (request.auth.uid == uid
                        || (resource.data.lastSeen is timestamp
                            && request.time - resource.data.lastSeen > duration.value(90, 's')));
    }

    match /rooms/study/signals/{signalId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.kind in ['sdp', 'ice']
                    && request.resource.data.to is string;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow update: if false;
    }

    // Study Groups (Học nhóm): tài liệu chia sẻ + giao bài tập
    match /groupCodes/{code} {
      function isVerifiedSelf() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.token.email_verified == true;
      }
      // Tra mã mời: chỉ cho phép lấy 1 doc theo ID (không list/query)
      allow get: if isVerifiedSelf();
      allow list: if false;
      allow create: if isVerifiedSelf()
                    && request.resource.data.groupId is string
                    && request.resource.data.groupName is string;
      allow update: if false;
      allow delete: if isVerifiedSelf()
                    && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      function isMember(uid) {
        return request.auth != null && uid in resource.data.memberUids;
      }
      function isVerified(uid) {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.token.email_verified == true
          && request.auth.uid == uid;
      }
      allow read: if isMember(request.auth.uid);
      allow create: if isVerified(request.resource.data.ownerUid)
                    && request.resource.data.memberUids.size() == 1
                    && request.resource.data.memberUids[0] == request.auth.uid
                    && request.resource.data.memberCount == 1
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.joinCode is string
                    && request.resource.data.joinCode.size() == 6;
      allow update: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.auth.token.email_verified == true
                    && ((request.auth.uid in resource.data.memberUids
                        || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                        // Tự tham gia: thêm đúng mình, đúng +1 thành viên (join qua mã mời)
                        || (request.auth.uid in request.resource.data.memberUids
                            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                            && request.resource.data.memberCount == resource.data.memberCount + 1))
                        && request.resource.data.memberUids.size() <= 20
                        && request.resource.data.memberCount <= 20);
      allow delete: if isVerified(resource.data.ownerUid);

      match /members/{uid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create, update: if isVerified(uid)
                      && (uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                          || get(/databases/$(database)/documents/groups/$(groupId)).data.memberCount < 20)
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 32
                      && request.resource.data.role in ['owner', 'member'];
        allow delete: if request.auth != null
                      && (request.auth.uid == uid
                          || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid);
      }

      match /files/{fileId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create: if isVerified(request.resource.data.authorId)
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      && request.resource.data.chunkCount is int
                      && request.resource.data.chunkCount >= 1
                      && request.resource.data.chunkCount <= 32;
        allow update, delete: if false;

        match /chunks/{chunkId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
          allow create: if isVerified(request.resource.data.authorId)
                        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        && request.resource.data.data is string
                        && request.resource.data.data.size() <= 1000000
                        && request.resource.data.index is int
                        && request.resource.data.index >= 0
                        && request.resource.data.index < 32;
          allow update, delete: if false;
        }
      }

      match /assignments/{assignmentId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow create: if isVerified(request.resource.data.assignerUid)
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                      && request.resource.data.title is string
                      && request.resource.data.title.size() >= 1
                      && request.resource.data.title.size() <= 120;
        allow update, delete: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.token.email_verified == true
                      && request.auth.uid == resource.data.assignerUid;

        match /completions/{uid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
          allow create, update: if isVerified(uid)
                        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
                        && request.resource.data.done == true
                        && request.resource.data.name is string;
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
